  </joint>
  <!-- ============================ ChArUco board ============================ -->
  <link name="charuco_board_frame_gt">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://annin_ar4_gazebo/models/charuco_5x7_35mm/charuco.obj"/>
      </geometry>
    </visual>
    <inertial>
      <origin xyz="0 0 0"/>
      <mass value="0.001"/>
      <inertia ixx="1e-7" ixy="0" ixz="0" iyy="1e-7" iyz="0" izz="1e-7"/>
    </inertial>
  </link>
  <!--
        Board on the wrist, facing out along ee +Z.
        rpy=(pi,0,0) sends board +Z to ee -Z, so the textured -Z face looks
        along ee +Z. The board's origin is its top-left corner, so the xyz
        offset (-W/2, +H/2, standoff) is what centres it on the ee axis.
        The standoff clears the gripper, which occupies ee +Z out to ~36 mm.
        The default camera stand sits out along -Y, since that is where ee +Z
        points at theta=0, so the board is in view from the home configuration
        rather than only after the collector stumbles onto a lucky pose.
      -->
  <joint name="charuco_mount_joint" type="fixed">
    <parent link="ee_link"/>
    <child link="charuco_board_frame_gt"/>
    <origin rpy="3.141592653589793 0 0" xyz="-0.0875 0.1225 0.12"/>
  </joint>
  <!--
      Rig links carry a tiny inertial and NO collision geometry.

      No collision, because: Gazebo then cannot wedge the camera into the arm;
      the MoveIt planning model (ar.urdf.xacro, which has no rig at all) stays
      collision-consistent with the simulated one, so no new disable_collisions
      entries are needed in the SRDF.

      A non-zero inertial, because sdformat lumps fixed-joint children into
      their parent by default (which is what we want - it also transfers the
      <gazebo reference> sensor below, with the pose composed correctly), but
      if that ever stops happening a preserved link with singular inertia makes
      bullet-featherstone emit NaNs and the whole articulation explodes.
    -->
  <link name="sim_camera_link_gt">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <box size="0.025 0.09 0.025"/>
      </geometry>
      <material name="sim_camera_body">
        <color rgba="0.15 0.15 0.17 1.0"/>
      </material>
    </visual>
    <inertial>
      <origin xyz="0 0 0"/>
      <mass value="0.001"/>
      <inertia ixx="1e-7" ixy="0" ixz="0" iyy="1e-7" iyz="0" izz="1e-7"/>
    </inertial>
  </link>
  <joint name="sim_camera_mount_joint" type="fixed">
    <parent link="base_link"/>
    <child link="sim_camera_link_gt"/>
    <origin rpy="0 0.15 1.5707963267948966" xyz="0 -0.85 0.45"/>
  </joint>
  <!-- Kept for naming parity with the RealSense chain. -->
  <link name="sim_camera_color_frame_gt"/>
  <joint name="sim_camera_color_joint" type="fixed">
    <parent link="sim_camera_link_gt"/>
    <child link="sim_camera_color_frame_gt"/>
    <origin rpy="0 0 0" xyz="0 0 0"/>
  </joint>
  <!-- REP-103 optical frame: +X right, +Y down, +Z forward. -->
  <link name="sim_camera_color_optical_frame_gt"/>
  <joint name="sim_camera_optical_joint" type="fixed">
    <parent link="sim_camera_color_frame_gt"/>
    <child link="sim_camera_color_optical_frame_gt"/>
    <origin rpy="-1.5707963267948966 0 -1.5707963267948966" xyz="0 0 0"/>
  </joint>
  <gazebo reference="sim_camera_link_gt">
    <!--
        A plain "camera", not "rgbd_camera": gz-sensors routes an rgbd_camera's
        <noise> to its depth image only, so colour noise is unreachable there.
        Two sensors on the same link give noisy colour AND depth that is
        aligned to it by construction.

        <gz_frame_id> must name the OPTICAL frame, not the link frame. gz
        renders along the link's +X, but the image and CameraInfo follow the
        optical pixel convention; naming the link frame would silently rotate
        every detected target pose by 90 degrees. sdformat does not know this
        element and logs "not defined in SDF. Copying[gz_frame_id]" - that
        warning is expected, and the element is preserved and honoured.
      -->
    <sensor name="sim_color" type="camera">
      <gz_frame_id>camera_color_optical_frame</gz_frame_id>
      <always_on>1</always_on>
      <update_rate>15.0</update_rate>
      <visualize>false</visualize>
      <topic>sim_camera/color/image_raw</topic>
      <camera>
        <camera_info_topic>sim_camera/color/camera_info</camera_info_topic>
        <horizontal_fov>1.2</horizontal_fov>
        <image>
          <width>1280</width>
          <height>720</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.02</near>
          <far>50.0</far>
        </clip>
        <!--
            No <distortion> on purpose. CameraInfo.d is then all zeros and
            ChArUco pose estimation is exact, so the only errors left in a
            ground-truth study are the ones deliberately injected. Adding lens
            distortion introduces an unmodelled term that cannot be separated
            from the kinematic perturbation afterwards; add it later as its own
            experiment if you want it.

            Worth knowing for the error budget: gz fills cx = width/2.0 where
            the pinhole-exact value is (width-1)/2. At fx ~= 935 and 0.4 m that
            half-pixel bias is about 0.2 mm laterally - the floor below which a
            "recovered" difference is not real.
          -->
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.0</stddev>
        </noise>
      </camera>
    </sensor>
  </gazebo>
  <!-- ============================== TCP tool =============================== -->
  <!--
      A pointed tool for WP2's pivot calibration, with its tip a known
      `tool_length` along ee +Z. Visual only: without collision geometry the
      needle passes through the reference sphere, which is what lets
      tcp_sim_poser place the tip exactly on the target.

      The tool offset is deliberately NOT perturbed. With a zero perturbation
      the recovered TCP offset should therefore equal (0, 0, tool_length)
      exactly; with a perturbation it deviates by the kinematic error, and that
      deviation is itself a WP2 result.
    -->
  <link name="tcp_tool_link">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0.075"/>
      <geometry>
        <cylinder length="0.15" radius="0.003"/>
      </geometry>
      <material name="tcp_tool">
        <color rgba="0.9 0.2 0.1 1.0"/>
      </material>
    </visual>
    <inertial>
      <origin xyz="0 0 0.075"/>
      <mass value="0.001"/>
      <inertia ixx="1e-7" ixy="0" ixz="0" iyy="1e-7" iyz="0" izz="1e-7"/>
    </inertial>
  </link>
  <joint name="tcp_tool_joint" type="fixed">
    <parent link="ee_link"/>
    <child link="tcp_tool_link"/>
    <origin rpy="0 0 0" xyz="0 0 0"/>
  </joint>
  <link name="tcp_tip_gt"/>
  <joint name="tcp_tip_joint" type="fixed">
    <parent link="ee_link"/>
    <child link="tcp_tip_gt"/>
    <origin rpy="0 0 0" xyz="0 0 0.15"/>
  </joint>
  <ros2_control name="mk5" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
      <param name="ar_model">mk5</param>
      <param name="serial_port">None</param>
      <param name="calibrate">False</param>
      <param name="calib_sequence">1012345</param>
      <param name="velocity_control_enabled">True</param>
      <param name="tf_prefix"></param>
    </hardware>
    <joint name="joint_1">
      <command_interface name="position">
        <param name="min">-2.792526803190927</param>
        <param name="max">2.792526803190927</param>
      </command_interface>
      <command_interface name="velocity"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity">
        <param name="initial_value">0.0</param>
      </state_interface>
      <param name="position_offset">160.0</param>
    </joint>
    <joint name="joint_2">
      <command_interface name="position">
        <param name="min">-0.7330382858376184</param>
        <param name="max">1.5707963267948966</param>
      </command_interface>
      <command_interface name="velocity"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity">
        <param name="initial_value">0.0</param>
      </state_interface>
      <param name="position_offset">-42.0</param>
    </joint>
    <joint name="joint_3">
      <command_interface name="position">
        <param name="min">-1.5533430342749532</param>
        <param name="max">0.9075712110370514</param>
      </command_interface>
      <command_interface name="velocity"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity">
        <param name="initial_value">0.0</param>
      </state_interface>
      <param name="position_offset">-89.0</param>
    </joint>
    <joint name="joint_4">
      <command_interface name="position">
        <param name="min">-3.141592653589793</param>
        <param name="max">3.141592653589793</param>
      </command_interface>
      <command_interface name="velocity"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity">
        <param name="initial_value">0.0</param>
      </state_interface>
      <param name="position_offset">-180.0</param>
    </joint>
    <joint name="joint_5">
      <command_interface name="position">
        <param name="min">-1.8325957145940461</param>
        <param name="max">1.8325957145940461</param>
      </command_interface>
      <command_interface name="velocity"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity">
        <param name="initial_value">0.0</param>
      </state_interface>
      <param name="position_offset">-105.0</param>
    </joint>
    <joint name="joint_6">
      <command_interface name="position">
        <param name="min">-3.141592653589793</param>
        <param name="max">3.141592653589793</param>
      </command_interface>
      <command_interface name="velocity"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity">
        <param name="initial_value">0.0</param>
      </state_interface>
      <param name="position_offset">-180.0</param>
    </joint>
  </ros2_control>
  <ros2_control name="ARGripperGazeboSystem" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
      <param name="serial_port">None</param>
      <param name="use_overcurrent_protection">False</param>
      <param name="closed_servo_angle">0</param>
      <param name="open_servo_angle">35</param>
      <param name="tf_prefix"></param>
    </hardware>
    <joint name="gripper_jaw1_joint">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity">
        <param name="initial_value">0.0</param>
      </state_interface>
    </joint>
    <joint name="gripper_jaw2_joint">
      <param name="mimic">gripper_jaw1_joint</param>
      <param name="multiplier">1</param>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity">
        <param name="initial_value">0.0</param>
      </state_interface>
    </joint>
  </ros2_control>
  <gazebo reference="world"/>
  <gazebo>
    <plugin filename="libgz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>/tmp/tmp24wn4htw.yaml</parameters>
      <ros>
        <namespace></namespace>
      </ros>
    </plugin>
  </gazebo>
</robot>
